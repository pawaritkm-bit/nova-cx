# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === LINE OA / LIFF (2 บัญชี) ===
# OA "Care" — ประเมินสำนักงานบัญชี (A) + ประเมินพนักงานทีมบัญชี (B)
LINE_CARE_CHANNEL_ID=
LINE_CARE_CHANNEL_SECRET=
LINE_CARE_CHANNEL_ACCESS_TOKEN=
LINE_CARE_LIFF_ID=

# OA "Sale" — ประเมินเซล ขายได้ (C) + ขายไม่ได้ (D)
LINE_SALE_CHANNEL_ID=
LINE_SALE_CHANNEL_SECRET=
LINE_SALE_CHANNEL_ACCESS_TOKEN=
LINE_SALE_LIFF_ID=

# group id ของ "กลุ่ม LINE สำนักงาน" (แบบประเมิน A ส่งเข้ากลุ่มนี้)
# fallback ระดับ env — เฟสแรกยังไม่เก็บ group id ต่อลูกค้าใน DB
LINE_CARE_OFFICE_GROUP_ID=
# tenant override สำหรับ LINE webhook (multi-tenant) — เว้นว่าง = ใช้ tenant แรกในระบบ
LINE_TENANT_ID=

# === ลงทะเบียนนักบัญชีผ่าน QR (LIFF) — /reg/staff ===
# LIFF สำหรับหน้า /reg/staff (endpoint ของ LIFF ต้องชี้ไป <APP_URL>/reg/staff)
# ⚠️ ต้องเป็น LIFF บน LINE Login channel ที่อยู่ "provider เดียวกับ Care OA"
#    ไม่งั้น userId จาก login จะไม่ตรงกับ userId ในกลุ่มแชต — เว้นว่าง = ใช้ LINE_CARE_LIFF_ID
LINE_STAFF_REG_LIFF_ID=
# channel id ของ LINE Login channel ที่ออก idToken (ใช้ verify idToken ฝั่ง server)
# เว้นว่าง = เดาจาก prefix ของ LIFF id (<channelId>-<random>)
LINE_LOGIN_CHANNEL_ID=
# รหัสลงทะเบียน (secret) — นักบัญชีต้องกรอกให้ตรงถึงจะผูก LINE↔พนักงานได้ (กันลูกค้า/คนนอก)
# เว้นว่าง = ปิดฟีเจอร์ลงทะเบียนทั้งหมด (fail-safe) — แจ้งรหัสนี้เฉพาะนักบัญชีเท่านั้น
STAFF_REGISTER_CODE=

# === เข้าสู่ระบบด้วย LINE (staff/นักบัญชี) — LINE Login OAuth ===
# channel secret ของ LINE Login channel (คู่กับ LINE_LOGIN_CHANNEL_ID ด้านบน)
#   ใช้แลก authorization code → token ตอน callback — เว้นว่าง = ปิด flow login ด้วย LINE
LINE_LOGIN_CHANNEL_SECRET=
# Callback URL ที่ต้องตั้ง "ให้ตรงเป๊ะ" ใน LINE Developers Console (LINE Login > Callback URL)
#   เว้นว่าง = ประกอบจาก NEXT_PUBLIC_APP_URL + /api/auth/line/callback
#   ตัวอย่าง prod: https://nova-cx.vercel.app/api/auth/line/callback
LINE_LOGIN_REDIRECT_URI=
# secret สำหรับเซ็น session cookie ของนักบัญชี (staff) + OAuth state — ต้องสุ่มยาว ≥32 ตัว
#   เว้นว่าง = ปิด staff login ทั้งหมด (fail-safe). สร้างด้วย: openssl rand -hex 32
STAFF_SESSION_SECRET=

# === AI ===
OPENAI_API_KEY=
AI_PROVIDER=openai
# โมเดลที่ใช้สรุป/จัดหมวด (รุ่น mini) — เว้นว่าง = gpt-4o-mini
OPENAI_MODEL=

# === Security ===
# กุญแจเข้ารหัส credential (ตั้งครั้งเดียว ห้ามเปลี่ยนภายหลัง)
CREDENTIAL_ENC_KEY=

# === Cron / Worker ===
# secret สำหรับ Vercel Cron (ส่งเป็น Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# === Integration: NOVA Sales → NOVA-CX ===
# secret ยืนยันตัวตนระหว่างระบบ — NOVA Sales ส่งมาใน header `x-api-key`
# เมื่อเปิดลูกค้า/ปิดดีล (Won/Lost) เพื่อ upsert ลูกค้า/ดีล + enqueue แบบประเมินเซล
# ถ้าเว้นว่าง endpoint /api/integrations/nova-sales/* จะตอบ 503 (ปิดไว้)
NOVA_SALES_API_KEY=
# tenant ที่ผูกกับ API key ด้านบน (allowlist) — integration รับเฉพาะ payload.tenant_id นี้
# กัน key เดียวเขียนข้าม tenant; เว้นว่าง = ไม่บังคับ (dev) แต่ควรตั้งใน prod
NOVA_SALES_TENANT_ID=
# === Outbound: NOVA-CX → NOVA Sale (ส่งเลขภาษีลูกค้ากลับ) ===
# endpoint ของ NOVA Sale ที่รับเลขภาษีที่นักบัญชีกรอกในหน้า /chat-audit/accounting
# POST { external_customer_id, customer_code, tax_id } + header x-api-key = NOVA_SALES_API_KEY
# เว้นว่าง = ปิด outbound (บันทึกเลขภาษีที่ CX อย่างเดียว ไม่ส่งกลับ — ไม่ error)
NOVA_SALES_OUTBOUND_URL=
# === Query: NOVA-CX → NOVA Sales (ดึงข้อมูลลูกค้ามาเติมฟอร์ม) ===
# ปุ่ม "ดึงจาก NOVA Sales" ในฟอร์มแก้ลูกค้า → query NOVA Sales External API v1 ด้วยเลขภาษี
# เอาชื่อ/ที่อยู่/เบอร์โทรมาเติมช่องให้ (ผู้ใช้ตรวจแล้วกดบันทึกเอง)
# base URL ของ External API v1 (read-only) เช่น https://nova-sales.vercel.app/api/v1 (ไม่ต้องมี / ปิดท้าย)
# เว้นว่าง = ปิดปุ่ม (แจ้ง "ยังไม่เปิดการเชื่อม" — ไม่ error)
NOVA_SALES_QUERY_URL=
# API key (Bearer) ของ External API v1 — คีย์ฝั่งบัญชีขึ้นต้น nova_acc_ (อยู่ใน env NOVA_API_KEYS ฝั่ง NOVA Sales)
# ส่งเป็น header Authorization: Bearer <key>
NOVA_SALES_QUERY_API_KEY=

# === Integration: FlowAccount OpenAPI (โปรแกรมบัญชี) ===
# OAuth2 client_credentials — ขอ token ที่ FLOWACCOUNT_TOKEN_URL แล้วยิง FLOWACCOUNT_API_BASE_URL
# เว้นว่าง = ปิดการเชื่อม (ไม่ error)
# Sandbox: https://openapi.flowaccount.com/test/token / https://openapi.flowaccount.com/test
# Production: https://openapi.flowaccount.com/v1/token / https://openapi.flowaccount.com/v1
FLOWACCOUNT_TOKEN_URL=
FLOWACCOUNT_API_BASE_URL=
FLOWACCOUNT_CLIENT_ID=
FLOWACCOUNT_CLIENT_SECRET=
FLOWACCOUNT_SCOPE=flowaccount-api
# ★ M1 จำกัดขอบเขตไว้ที่ 1 บริษัทลูกค้า (credential ข้างบนเป็น env ระดับเดียว ไม่ผูกต่อ customers แต่ละราย)
# ใส่ uuid ของ customers.id ที่อนุญาตให้ส่งไป FlowAccount — เว้นว่าง = ไม่บังคับ (dev only, ควรตั้งใน prod)
# ตั้งไว้แล้ว → ลูกค้ารายอื่น (แม้ confirmed+sale) กดส่งไม่ได้ (ดู docs/05-flowaccount-integration.md หมวด 0.3)
FLOWACCOUNT_CUSTOMER_ID=

# === Bill Storage: ที่เก็บรูปบิลจาก LINE (เฟส 1) ===
# เลือก backend: supabase (default) | drive | onedrive
#   - supabase : อัปเข้า Supabase Storage bucket `bills` (private) + signed URL
#                ใช้ SUPABASE_SERVICE_ROLE_KEY ที่ตั้งไว้ด้านบน — ไม่ต้องตั้ง env เพิ่ม
#                (bucket `bills` ต้องสร้างไว้แล้วแบบ private)
#   - drive    : ใช้ Google Drive service account เดิม (ต้องตั้ง 2 ตัวด้านล่าง)
#   - onedrive : ใช้ Microsoft 365 OneDrive ของบริษัท (ต้องตั้ง section OneDrive ด้านล่าง)
# เว้นว่าง = supabase (ใช้ได้เลยไม่ต้องตั้งค่าเพิ่ม)
BILL_STORAGE_BACKEND=supabase

# === Google Drive: เก็บรูปบิลจาก LINE (ทางเลือก — ใช้เมื่อ BILL_STORAGE_BACKEND=drive) ===
# service account JSON ทั้งก้อน (บรรทัดเดียว) — ต้องมี client_email + private_key
# แชร์โฟลเดอร์ปลายทางให้ client_email ของ SA มีสิทธิ์ Editor ก่อน
# เว้นว่าง = ปิดฟีเจอร์ดึงรูปทั้งหมด (cron process-attachments คืน {disabled:true}, ไม่กระทบระบบเดิม)
GOOGLE_DRIVE_SA_JSON=
# id โฟลเดอร์รากบน Drive (จาก URL ...folders/<ID>) ที่จะสร้างโฟลเดอร์ลูกค้า/เดือนซ้อนใต้
GDRIVE_ROOT_FOLDER_ID=

# === OneDrive: เก็บรูปบิลจาก LINE (ทางเลือก — ใช้เมื่อ BILL_STORAGE_BACKEND=onedrive) ===
# Microsoft 365 OneDrive ของบริษัท ผ่าน Microsoft Graph (app-only / client credentials)
# ต้องลงทะเบียน app ใน Entra ID (Azure AD) และให้สิทธิ์ Application "Files.ReadWrite.All"
#   (admin consent) ถึงจะเขียนไฟล์เข้า OneDrive ของ ONEDRIVE_USER ได้
# บังคับ 4 ตัวแรก — ขาดตัวใดตัวหนึ่ง = ปิดฟีเจอร์ OneDrive (ไม่ยิงเครือข่าย ไม่กระทบระบบเดิม)
# ตั้ง BILL_STORAGE_BACKEND=onedrive ด้านบนเพื่อเปิดใช้ backend นี้
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# UPN เจ้าของ OneDrive ที่จะเก็บไฟล์ (เช่น finovas@wanwanach.com)
ONEDRIVE_USER=
# โฟลเดอร์รากใน OneDrive ที่จะสร้างโฟลเดอร์ลูกค้า/เดือนซ้อนใต้ — เว้นว่าง = "NOVA-Bills"
ONEDRIVE_ROOT=

# === Test (optional) ===
# ใช้เฉพาะรัน RLS/permission test กับ Postgres จริง (เว้นว่าง = ข้าม test กลุ่มนี้)
DATABASE_URL=

# === App base URL (สร้างลิงก์แบบประเมิน survey_url ฝั่งเซล) ===
NEXT_PUBLIC_APP_URL=
