{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/cron/health-ping",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/process-ai",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scan-invitations",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/process-evaluations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/process-attachments",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/retry-locked",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/generate-recurring-je",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/generate-fixed-asset-depreciation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/generate-payroll-filing-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-recurring-invoice",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "app/api/accounting/extract-upload/route.ts": {
      "maxDuration": 120
    },
    "app/api/accounting/extract-share-circle/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/process-attachments/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/extract-bills/route.ts": {
      "maxDuration": 300
    },
    "app/api/**/route.ts": {
      "maxDuration": 60
    }
  }
}
